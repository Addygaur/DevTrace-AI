# CockroachDB Cloud connection string
# Example: postgresql://user:password@free-tier.aws-us-east-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
DATABASE_URL=

# Amazon Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional if using SSO / instance role
# AWS_PROFILE=

# Bedrock model IDs (override if your region uses different IDs)
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Chat model: Nova works immediately. Claude needs Anthropic use-case form in Bedrock.
# Claude later: us.anthropic.claude-sonnet-4-6
BEDROCK_CHAT_MODEL=amazon.nova-pro-v1:0

# Embedding dimensions (Titan Embed Text v2: 256 | 512 | 1024)
EMBEDDING_DIMENSIONS=1024

# CockroachDB Cloud MCP (for Cursor / agent demo)
COCKROACH_CLUSTER_ID=
# COCKROACH_MCP_API_KEY=

# Demo project slug
DEMO_PROJECT_SLUG=shopflow
