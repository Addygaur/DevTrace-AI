{
  "name": "devtrace-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DevTrace AI — Engineering memory agent powered by CockroachDB + Amazon Bedrock",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @devtrace/web",
    "build": "npm run build -w @devtrace/web",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate:ccloud": "bash scripts/ccloud-migrate.sh",
    "typecheck": "tsc -p packages/db --noEmit && tsc -p packages/agent --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
